          </select>
        </div>

        <div id="egyptian-subjects-block" style="display: none;">
          <div class="table-responsive">
            <table class="grades-table">
              <thead>
                <tr>
                  <th class="col-num">#</th>
                  <th class="col-subject">اسم المادة</th>
                  <th class="col-grade">الدرجة</th>
                  <th class="col-weight">الدرجة العظمى</th>
                </tr>
              </thead>
              <tbody id="egyptian-subjects-body">
                <!-- Dynamically populated based on المسار + نظام المواد -->
              </tbody>
            </table>
          </div>

          <div class="result-box" style="margin-top: 1.5rem;">
            <div class="result-row-flex">
              <div class="result-flex-item">
                <div class="result-title-label">مجموع الدرجات:</div>
                <div class="result-value" id="egyptian-final-total">0.00 / 0</div>
              </div>
              <div class="result-flex-item" style="border-right: 1px solid var(--border-color); padding-right: 1.5rem;">
                <div class="result-title-label">النسبة المئوية:</div>
                <div class="result-value" id="egyptian-percentage">0.00%</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Azhar Thanaweya Calculator Container: القسم (from the shared track-select) selects a
           fixed subject list directly — no secondary system select, unlike Egyptian. -->
      <div id="azhar-grades-container" style="display: none;">
        <div class="table-responsive">
          <table class="grades-table">
            <thead>
              <tr>
                <th class="col-num">#</th>
                <th class="col-subject">اسم المادة</th>
                <th class="col-grade">الدرجة</th>
                <th class="col-weight">الدرجة العظمى</th>
              </tr>
            </thead>
            <tbody id="azhar-subjects-body">
              <!-- Dynamically populated based on القسم -->
            </tbody>
          </table>
        </div>

        <div class="result-box" style="margin-top: 1.5rem;">
          <div class="result-row-flex">
            <div class="result-flex-item">
              <div class="result-title-label">مجموع الدرجات:</div>
              <div class="result-value" id="azhar-final-total">0.00 / 0</div>
            </div>
            <div class="result-flex-item" style="border-right: 1px solid var(--border-color); padding-right: 1.5rem;">
              <div class="result-title-label">النسبة المئوية:</div>
              <div class="result-value" id="azhar-percentage">0.00%</div>
            </div>
            <div class="result-flex-item" style="border-right: 1px solid var(--border-color); padding-right: 1.5rem;">
              <div class="result-title-label">المجموع الاعتباري (المجموع المصري):</div>
              <div class="result-value" id="azhar-equivalent-total">0.00 / 410</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Emirati Certificate Calculator Container: single track today (no track-selection UI —
           handled entirely inside the certification select's handler, same convention as "أخرى"). -->
      <div id="emirati-grades-container" style="display: none;">
        <div id="emirati-medical-warning" class="alert alert-warning" style="display: none; margin-bottom: 1.25rem; line-height: 1.9;">
          <strong>⚠️ تنبيه:</strong>
          <p style="margin: 0.5rem 0 0;">عند اختيار أي رغبة من الرغبات الطبية، يجب إدخال الدرجات التفصيلية للمواد المضافة للمجموع (الموجودة في شهادتك) إن وُجدت، لأنها مطلب أساسي وإلزامي في التنسيق المصري للقبول بالكليات الطبية، ولن يتم النظر في رغبتك دون إدخالها.</p>
        </div>

        <div class="table-responsive">
          <table class="grades-table">
            <thead>
              <tr>
                <th class="col-num">#</th>
                <th class="col-subject">اسم المادة</th>
                <th class="col-grade">الدرجة</th>
                <th class="col-weight">الدرجة العظمى</th>
              </tr>
            </thead>
            <tbody id="emirati-subjects-body">
              <!-- Dynamically populated: 5 core (required) + 3 optional subjects -->
            </tbody>
          </table>
        </div>

        <div class="result-box" style="margin-top: 1.5rem;">
          <div class="result-row-flex">
            <div class="result-flex-item">
              <div class="result-title-label">مجموع الدرجات:</div>
              <div class="result-value" id="emirati-final-total">0.00 / 0</div>
            </div>
            <div class="result-flex-item" style="border-right: 1px solid var(--border-color); padding-right: 1.5rem;">
              <div class="result-title-label">النسبة المئوية:</div>
              <div class="result-value" id="emirati-percentage">0.00%</div>
            </div>
            <div class="result-flex-item" style="border-right: 1px solid var(--border-color); padding-right: 1.5rem;">
              <div class="result-title-label">المجموع الاعتباري (المجموع المصري):</div>
              <div class="result-value" id="emirati-equivalent-total">0.00 / 410</div>
            </div>
          </div>
        </div>
      </div>

      <!-- American Diploma Calculator Container: no track selector at all (mirrors "أخرى"/Emirati).
           Admission depends on BasePercentage + SAT I + SAT II together — never one combined number. -->
      <div id="american-diploma-grades-container" style="display: none;">
        <div class="table-responsive">
          <table class="grades-table">
            <thead>
              <tr>
                <th class="col-num">#</th>
                <th class="col-subject">المادة</th>
                <th class="col-grade">الدرجة</th>
                <th class="col-weight">الدرجة العظمى</th>
              </tr>
            </thead>
            <tbody id="american-diploma-subjects-body">
              <!-- Dynamically populated: 8 "أفضل مواد" rows -->
            </tbody>
          </table>
        </div>

        <div class="result-box" style="margin-top: 1.5rem;">
          <div class="result-row-flex">
            <div class="result-flex-item">
              <div class="result-title-label">المعدل (من 100):</div>
              <div class="result-value" id="american-diploma-average">0.00</div>
            </div>
            <div class="result-flex-item" style="border-right: 1px solid var(--border-color); padding-right: 1.5rem;">
              <div class="result-title-label">النسبة الأساسية (من 40):</div>
              <div class="result-value" id="american-diploma-base-percentage">0.00 / 40</div>
            </div>
          </div>
        </div>

        <div class="info-card" style="margin-top: 1.5rem;">
          <div class="info-card-header">
            <div class="info-card-label">درجات اختبار SAT</div>
            <div class="info-card-subtitle">الحقول المميزة بـ <span style="color:var(--danger-color)">*</span> إلزامية</div>
          </div>
          <div class="form-grid-2">
            <div class="form-group">
              <label for="american-diploma-sat1">درجة SAT I <span class="required">*</span></label>
              <input type="number" id="american-diploma-sat1" class="form-control" min="400" max="1600" step="1" placeholder="400-1600" required>
              <div class="field-warning" id="american-diploma-sat1-warning"></div>
            </div>
            <div class="form-group" id="american-diploma-sat2-group" style="display: none;">
              <label for="american-diploma-sat2" id="american-diploma-sat2-label">درجة SAT II <span class="required">*</span></label>
              <input type="number" id="american-diploma-sat2" class="form-control" min="400" max="1600" step="1" placeholder="400-1600">
              <div class="field-hint">تاريخ اختبار SAT II يجب ألا يتعدى تاريخ الحصول على الدبلومة الأمريكية.</div>
              <div class="field-hint" id="american-diploma-sat2-requirement-hint"></div>
              <div class="field-warning" id="american-diploma-sat2-warning"></div>
            </div>
          </div>
          <div class="form-group" id="american-diploma-advanced-math-group" style="display: none;">
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 500;">
              <input type="checkbox" id="american-diploma-advanced-math-checkbox" style="width: auto;">
              <span>درست الرياضيات المتقدمة (Math / Adv. Math)؟</span>
            </label>
            <div class="field-hint">إذا أكدت ذلك، تصبح درجة SAT II اختيارية لهذه الكلية بدلاً من إلزامية.</div>
          </div>
          <div class="form-grid-2" id="american-diploma-sat2-subjects-group" style="display: none;">
            <div class="form-group">
              <label for="american-diploma-sat2-subject1">مادة SAT II الأولى</label>
              <select id="american-diploma-sat2-subject1" class="form-control" disabled>
                <option value="">-- اختر --</option>
              </select>
            </div>
            <div class="form-group">
              <label for="american-diploma-sat2-subject2">مادة SAT II الثانية <span class="required">*</span></label>
              <select id="american-diploma-sat2-subject2" class="form-control">
                <option value="">-- اختر --</option>
              </select>
            </div>
          </div>
        </div>

        <div class="alert alert-warning" style="margin-top: 1.5rem; line-height: 1.9;">
          <strong>ℹ️ ملاحظة هامة حول القبول:</strong>
          <p style="margin: 0.5rem 0 0;">القبول النهائي بالكلية يعتمد على استيفاء الشروط الثلاثة معًا: المعدل الدراسي (أفضل 8 مواد) + درجة SAT I + درجة SAT II (حسب الكلية المختارة) — وليس على رقم نهائي واحد كما هو الحال في باقي الشهادات.</p>
        </div>
      </div>

      <!-- "أخرى" (Other) Calculator Container: free-text certificate name + percentage-in only,
           no track/subjects/year UI. -->
      <div id="other-grades-container" style="display: none;">
        <div class="form-group">
          <label for="other-certificate-name">اسم الشهادة <span class="required">*</span></label>
          <input type="text" id="other-certificate-name" class="form-control" maxlength="200" placeholder="أدخل اسم الشهادة" required>
        </div>
        <div class="form-group" style="max-width: 300px;">
          <label for="other-percentage">النسبة المئوية <span class="required">*</span></label>
          <input type="number" id="other-percentage" class="form-control" min="0" max="100" step="any" placeholder="0-100" required>
        </div>

        <div class="result-box" style="margin-top: 1.5rem;">
          <div class="result-row-flex">
            <div class="result-flex-item">
              <div class="result-title-label">النسبة المئوية:</div>
              <div class="result-value" id="other-percentage-val">0.00%</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Form Action Buttons -->
    <div class="form-actions">
      <button type="submit" class="btn btn-primary" id="btn-submit">حفظ وإرسال البيانات 💾</button>
      <button type="reset" class="btn btn-secondary" onclick="location.reload();">إعادة تعيين 🔄</button>
    </div>

  </form>

  <!-- Success Confirmation Dialog Screen -->
  <div class="success-screen" id="success-screen">
    <div class="success-icon">✓</div>
    <h2 class="success-title">تم حفظ البيانات بنجاح</h2>
    <p class="success-desc" id="receipt-mode">تم إرسال وحفظ بيانات استمارة الطالب.</p>

    <!-- Receipt Summary Card -->
    <div class="receipt-card">
      <div class="receipt-row">
        <span class="receipt-label">اسم الطالب:</span>
        <span class="receipt-val" id="receipt-name">-</span>
      </div>
      <div class="receipt-row">
        <span class="receipt-label">الرقم القومي:</span>
        <span class="receipt-val" id="receipt-id">-</span>
      </div>
      <div class="receipt-row">
        <span class="receipt-label">نوع الشهادة:</span>
        <span class="receipt-val" id="receipt-cert">-</span>
      </div>
      <div class="receipt-row" id="receipt-program-row" style="display: none;">
        <span class="receipt-label" id="receipt-program-label">برنامج الـ IG:</span>
        <span class="receipt-val" id="receipt-program">-</span>
      </div>
      <div class="receipt-row" id="receipt-year-row">
        <span class="receipt-label" id="receipt-year-label">السنة الدراسية:</span>
        <span class="receipt-val" id="receipt-year">-</span>
      </div>
      <div class="receipt-row" id="receipt-saudi-gpa-row" style="display: none;">
        <span class="receipt-label">النسبة المئوية النهائية (GPA):</span>
        <span class="receipt-val" id="receipt-saudi-gpa">-</span>
      </div>
    </div>

    <!-- Action buttons on success -->
    <div class="success-actions">
      <div class="btn-group-row">
        <button class="btn btn-primary" id="btn-download-json" style="flex:1;">تنزيل ملف البيانات JSON 📥</button>
        <button class="btn btn-secondary" id="btn-download-csv" style="flex:1;">تنزيل ملف إكسل CSV 📊</button>
      </div>
      <button class="btn btn-secondary" id="btn-new-form">تسجيل استمارة جديدة 🔄</button>
    </div>
  </div>

  <!-- Generic confirmation / input modal (used by Saudi subject add/delete) -->
  <div class="app-modal-overlay" id="app-modal-overlay">
    <div class="app-modal-box" id="app-modal-box">
      <h3 class="app-modal-title" id="app-modal-title"></h3>
      <div class="app-modal-body" id="app-modal-body"></div>
      <div class="app-modal-footer">
        <button type="button" class="btn btn-secondary" id="app-modal-cancel" style="flex:1;">إلغاء</button>
        <button type="button" class="btn btn-primary" id="app-modal-confirm" style="flex:1;">تأكيد</button>
      </div>
    </div>
  </div>

  <!-- Toast notifications -->
  <div class="app-toast-container" id="app-toast-container"></div>
</div>

@section Scripts {
  <script src="~/js/conditional.js" asp-append-version="true"></script>
  <script src="~/js/form-handler.js" asp-append-version="true"></script>
  <script src="~/js/app.js" asp-append-version="true"></script>
}
